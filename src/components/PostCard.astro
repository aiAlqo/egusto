---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import TagPill from './TagPill.astro';
import { extractSnippet } from '../lib/text';
import { getResponsiveImage } from '../lib/image-dimensions';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
const snippet = extractSnippet(post.body ?? '');
const dateStr = post.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
const cover = post.data.cover ? getResponsiveImage(post.data.cover) : null;
---

<article class="card fade-in w-full">
  {post.data.cover && cover && (
    <img
      src={post.data.cover}
      srcset={cover.srcset}
      sizes="(max-width: 640px) 100vw, (max-width: 1024px) 90vw, 944px"
      width={cover.width}
      height={cover.height}
      alt=""
      class="mb-6 aspect-[21/9] w-full rounded-xl object-cover"
      loading="lazy"
    />
  )}
  <div class="flex flex-wrap items-center gap-3 text-xs text-claude-muted">
    <span>{dateStr}</span>
    {post.data.tags.length > 0 && (
      <div class="flex gap-2">
        {post.data.tags.map((tag) => <TagPill tag={tag} />)}
      </div>
    )}
  </div>
  <h2 class="mt-3 text-2xl font-semibold text-claude-cream">
    <a href={`/posts/${post.id}`} class="hover:text-claude-accent-hover">
      {post.data.title}
    </a>
  </h2>
  <p class="mt-3 max-w-[65ch] text-claude-muted">{snippet}</p>

  <details class="group mt-4">
    <summary class="flex w-fit cursor-pointer list-none items-center gap-1.5 text-sm font-medium text-claude-accent transition hover:text-claude-accent-hover">
      <span class="group-open:hidden">Read more</span>
      <span class="hidden group-open:inline">Show less</span>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 20 20"
        fill="currentColor"
        class="h-4 w-4 transition-transform group-open:rotate-180"
      >
        <path
          fill-rule="evenodd"
          d="M5.23 7.21a.75.75 0 011.06.02L10 10.94l3.71-3.71a.75.75 0 111.06 1.06l-4.24 4.25a.75.75 0 01-1.06 0L5.21 8.29a.75.75 0 01.02-1.08z"
          clip-rule="evenodd"
        />
      </svg>
    </summary>
    <div class="prose-post !mx-0 mt-6 max-w-none border-t border-white/5 pt-6">
      <Content />
    </div>
    <a
      href={`/posts/${post.id}`}
      class="mt-6 inline-block text-sm text-claude-accent hover:text-claude-accent-hover"
    >
      View permalink →
    </a>
  </details>
</article>
