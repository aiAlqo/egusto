---
import type { CollectionEntry } from 'astro:content';
import { extractSnippet } from '../lib/text';
import { getResponsiveImage } from '../lib/image-dimensions';

interface Props {
  post: CollectionEntry<'posts'>;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const snippet = extractSnippet(post.body ?? '');
const dateStr = post.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
const cover = post.data.cover ? getResponsiveImage(post.data.cover) : null;
const href = `/posts/${post.id}/`;
const topic = post.data.tags[0];
---

{featured ? (
  <article class="group grid gap-6 md:grid-cols-[1.35fr_1fr] md:items-center md:gap-10">
    {post.data.cover && cover && (
      <a href={href} tabindex="-1" aria-hidden="true" class="block overflow-hidden rounded-sm">
        <img
          src={post.data.cover}
          srcset={cover.srcset}
          sizes="(max-width: 768px) 100vw, 560px"
          width={cover.width}
          height={cover.height}
          alt=""
          class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-[1.02] motion-reduce:transition-none"
        />
      </a>
    )}
    <div>
      <p class="kicker">
        <time datetime={post.data.date.toISOString()}>{dateStr}</time>
        {topic && <span> · {topic.replace(/-/g, ' ')}</span>}
      </p>
      <h2 class="mt-3 font-serif text-3xl leading-tight font-semibold text-balance sm:text-4xl">
        <a href={href} class="decoration-orange decoration-2 underline-offset-4 group-hover:underline">
          {post.data.title}
        </a>
      </h2>
      <p class="mt-4 font-serif text-lg leading-relaxed text-muted">{snippet}</p>
    </div>
  </article>
) : (
  <article class="group grid grid-cols-[1fr_6.5rem] gap-5 border-t border-rule py-7 sm:grid-cols-[8rem_1fr_9rem] sm:gap-8">
    <p class="kicker col-span-2 sm:col-span-1 sm:pt-1.5">
      <time datetime={post.data.date.toISOString()}>{dateStr}</time>
    </p>
    <div>
      <h2 class="font-serif text-xl leading-snug font-semibold text-balance sm:text-2xl">
        <a href={href} class="decoration-orange decoration-2 underline-offset-4 group-hover:underline">
          {post.data.title}
        </a>
      </h2>
      <p class="mt-2 line-clamp-2 text-[0.95rem] leading-relaxed text-muted">{snippet}</p>
    </div>
    {post.data.cover && cover && (
      <a href={href} tabindex="-1" aria-hidden="true" class="block self-start overflow-hidden rounded-sm">
        <img
          src={post.data.cover}
          srcset={cover.srcset}
          sizes="160px"
          width={cover.width}
          height={cover.height}
          alt=""
          class="aspect-square w-full object-cover sm:aspect-[4/3]"
          loading="lazy"
        />
      </a>
    )}
  </article>
)}
