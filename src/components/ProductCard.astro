---
import type { CollectionEntry } from 'astro:content';
import { getResponsiveImage } from '../lib/image-dimensions';

interface Props {
  product: CollectionEntry<'products'>;
}

const { product } = Astro.props;
const { title, description, price, image, downloadUrl, guide, buyLink } = product.data;
const productImage = image ? getResponsiveImage(image) : null;
const isPaid = Boolean(buyLink) && !downloadUrl;
---

<article
  class:list={[
    'grid gap-6 border-t border-rule py-8',
    image && productImage ? 'sm:grid-cols-[13rem_1fr] sm:gap-8' : '',
  ]}
>
  {image && productImage && (
    <img
      src={image}
      srcset={productImage.srcset}
      sizes="(max-width: 640px) 100vw, 208px"
      width={productImage.width}
      height={productImage.height}
      alt=""
      class="aspect-square w-full max-w-[13rem] rounded-sm object-cover"
      loading="lazy"
    />
  )}
  <div class="flex max-w-[60ch] flex-col">
    <h3 class="font-serif text-2xl leading-snug font-semibold text-balance">{title}</h3>
    <p class="mt-3 leading-relaxed text-muted">{description}</p>
    <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3">
      {downloadUrl ? (
        <a href={downloadUrl} download class="btn">
          Download
        </a>
      ) : buyLink ? (
        <a href={buyLink} target="_blank" rel="noopener" class="btn">
          {isPaid && price !== 'Free' ? `Buy for ${price}` : 'Get it free'}
        </a>
      ) : null}
      {guide && (
        <a
          href={guide}
          class="text-sm text-indigo underline decoration-orange decoration-2 underline-offset-4 hover:decoration-indigo"
        >
          Read the guide
        </a>
      )}
      {!isPaid && <span class="text-sm text-muted">Free</span>}
    </div>
  </div>
</article>
