---
import type { CollectionEntry } from 'astro:content';
import { getResponsiveImage } from '../lib/image-dimensions';

interface Props {
  product: CollectionEntry<'products'>;
}

const { product } = Astro.props;
const { title, description, price, image, downloadUrl, buyLink } = product.data;
const productImage = image ? getResponsiveImage(image) : null;
const isPaid = Boolean(buyLink) && !downloadUrl;
---

<div
  class:list={[
    'card fade-in flex flex-col',
    isPaid && 'border-claude-accent/40 shadow-[0_0_32px_-8px_rgba(217,119,87,0.35)]',
  ]}
>
  {isPaid && (
    <span class="mb-3 w-fit rounded-full bg-claude-accent px-2.5 py-0.5 text-xs font-semibold uppercase tracking-wide text-claude-dark">
      Premium
    </span>
  )}
  {image && productImage && (
    <img
      src={image}
      srcset={productImage.srcset}
      sizes="(max-width: 640px) 100vw, (max-width: 1024px) 45vw, 300px"
      width={productImage.width}
      height={productImage.height}
      alt=""
      class:list={[
        'mb-4 w-full rounded-xl object-cover',
        isPaid ? 'aspect-square' : 'aspect-video',
      ]}
      loading="lazy"
    />
  )}
  <h2 class="text-lg font-semibold text-claude-cream">{title}</h2>
  <p class="mt-2 flex-1 text-sm text-claude-muted">{description}</p>
  <div class="mt-6 flex items-center justify-between">
    <span class="text-sm font-medium text-claude-cream">{price}</span>
    {downloadUrl ? (
      <a
        href={downloadUrl}
        download
        class="rounded-full bg-claude-accent px-4 py-2 text-sm font-medium text-claude-dark transition hover:bg-claude-accent-hover"
      >
        Download
      </a>
    ) : buyLink ? (
      <a
        href={buyLink}
        target="_blank"
        rel="noopener"
        class="rounded-full bg-claude-accent px-4 py-2 text-sm font-medium text-claude-dark transition hover:bg-claude-accent-hover"
      >
        Buy — {price}
      </a>
    ) : null}
  </div>
</div>
