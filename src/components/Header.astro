---
import { getImageDimensions } from '../lib/image-dimensions';

const navItems = [
  { href: '/', label: 'Writing' },
  { href: '/store/', label: 'Skill-Store' },
  { href: '/about/', label: 'About' },
];

const currentPath = Astro.url.pathname;
const logo = getImageDimensions('/brand/logo-lookup.png');
---

<header class="border-b border-rule bg-paper">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-2">
    <a href="/" class="-ml-3 block shrink-0">
      <img
        src="/brand/logo-lookup.png"
        alt="egusto"
        width={logo?.width}
        height={logo?.height}
        class="h-14 w-auto"
      />
    </a>
    <nav class="flex gap-5 text-sm sm:gap-7">
      {navItems.map((item) => {
        const isActive =
          item.href === '/'
            ? currentPath === '/' || currentPath.startsWith('/posts/')
            : currentPath.startsWith(item.href);
        return (
          <a
            href={item.href}
            aria-current={isActive ? 'page' : undefined}
            class:list={[
              'border-b-2 py-1 transition-colors hover:text-ink',
              isActive ? 'border-orange text-ink' : 'border-transparent text-muted',
            ]}
          >
            {item.label}
          </a>
        );
      })}
    </nav>
  </div>
</header>
