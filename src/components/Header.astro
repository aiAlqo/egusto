---
import { getImageDimensions } from '../lib/image-dimensions';

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/store', label: 'Store' },
  { href: '/about', label: 'About' },
];

const currentPath = Astro.url.pathname;
const logo = getImageDimensions('/brand/logo-lookup.png');
const banner = getImageDimensions('/brand/banner.jpg');
---

<header class="sticky top-0 z-50 border-b border-white/5 bg-claude-dark/95 backdrop-blur">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-5">
    <a href="/" class="block overflow-hidden rounded-lg">
      <img
        src="/brand/logo-lookup.png"
        alt="egusto"
        width={logo?.width}
        height={logo?.height}
        class="h-9 w-auto"
      />
    </a>
    <nav class="flex gap-6 text-sm">
      {navItems.map((item) => {
        const isActive = item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href);
        return (
          <a
            href={item.href}
            class={`transition hover:text-claude-accent-hover ${
              isActive ? 'text-claude-accent' : 'text-claude-muted'
            }`}
          >
            {item.label}
          </a>
        );
      })}
    </nav>
  </div>
</header>
<img
  src="/brand/banner.jpg"
  alt=""
  width={banner?.width}
  height={banner?.height}
  class="h-28 w-full object-cover object-bottom sm:h-36"
/>
