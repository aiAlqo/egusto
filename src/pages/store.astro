---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';

const byFeatured = (a, b) => Number(b.data.featured) - Number(a.data.featured);
const allProducts = await getCollection('products');
const paidProducts = allProducts.filter((p) => p.data.buyLink && !p.data.downloadUrl).sort(byFeatured);
const freeProducts = allProducts.filter((p) => !(p.data.buyLink && !p.data.downloadUrl)).sort(byFeatured);
---

<BaseLayout
  title="Skill-Store"
  description="Claude Skills and digital resources — free downloads and paid templates."
>
  <section class="mx-auto max-w-5xl px-4 pt-12 pb-16 sm:pt-16">
    <h1 class="font-serif text-4xl font-semibold sm:text-5xl">Skill-Store</h1>
    <p class="mt-4 max-w-2xl text-lg text-muted">
      Claude Skills I've built and use myself. Each one comes with a write-up on the blog
      explaining how it works, so you can read before you download.
    </p>
    {paidProducts.length > 0 && (
      <div class="mt-14">
        <h2 class="kicker mb-2">Paid</h2>
        {paidProducts.map((product) => <ProductCard product={product} />)}
      </div>
    )}
    {freeProducts.length > 0 && (
      <div class="mt-14">
        <h2 class="kicker mb-2">Free</h2>
        {freeProducts.map((product) => <ProductCard product={product} />)}
      </div>
    )}
    {allProducts.length === 0 && (
      <p class="mt-10 text-muted">Nothing here yet.</p>
    )}
  </section>
</BaseLayout>
