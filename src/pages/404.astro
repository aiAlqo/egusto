---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="This page doesn't exist.">
  <section class="mx-auto flex max-w-3xl flex-col items-center px-4 py-32 text-center">
    <p class="text-sm font-medium text-claude-accent">404</p>
    <h1 class="mt-3 text-3xl font-semibold text-claude-cream">Page not found</h1>
    <p class="mt-3 text-claude-muted">The page you're looking for doesn't exist or has moved.</p>
    <a
      href="/"
      class="mt-8 rounded-full bg-claude-accent px-5 py-2.5 text-sm font-medium text-claude-dark transition hover:bg-claude-accent-hover"
    >
      Back home
    </a>
  </section>
</BaseLayout>
