---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="This page doesn't exist.">
  <section class="mx-auto flex max-w-3xl flex-col items-center px-4 py-32 text-center">
    <p class="kicker">404</p>
    <h1 class="mt-3 font-serif text-4xl font-semibold">Page not found</h1>
    <p class="mt-3 text-muted">The page you're looking for doesn't exist or has moved.</p>
    <a
      href="/"
      class="btn mt-8"
    >
      Back home
    </a>
  </section>
</BaseLayout>
