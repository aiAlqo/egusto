---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagPill from '../../components/TagPill.astro';
import AdSlot from '../../components/AdSlot.astro';
import { SIDEBAR_SLOT } from '../../lib/ad-config.mjs';
import { getResponsiveImage } from '../../lib/image-dimensions';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) =>
    import.meta.env.PROD ? !data.draft : true
  );
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const dateStr = post.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const canonicalUrl = new URL(`/posts/${post.id}/`, Astro.site).toString();
const logoUrl = new URL('/brand/app-icon.png', Astro.site).toString();
const imageUrl = new URL(
  post.data.cover ?? '/brand/banner.jpg',
  Astro.site
).toString();

const blogPostingSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  dateModified: post.data.date.toISOString(),
  image: imageUrl,
  author: { '@type': 'Organization', name: 'egusto' },
  publisher: {
    '@type': 'Organization',
    name: 'egusto',
    logo: { '@type': 'ImageObject', url: logoUrl },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
};

const cover = post.data.cover ? getResponsiveImage(post.data.cover) : null;
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  structuredData={blogPostingSchema}
>
  <div class="mx-auto max-w-6xl px-4 py-16 lg:grid lg:grid-cols-[300px_1fr] lg:items-start lg:gap-10">
    <aside class="hidden lg:sticky lg:top-24 lg:block lg:self-start">
      <AdSlot slot={SIDEBAR_SLOT} />
    </aside>
    <article class="mx-auto min-w-0 max-w-3xl">
      <header class="mx-auto mb-10 max-w-[38rem]">
        <p class="kicker">
          <time datetime={post.data.date.toISOString()}>{dateStr}</time> · Alois Seneka
        </p>
        <h1 class="mt-4 font-serif text-[2.1rem] leading-[1.12] font-semibold text-balance sm:text-5xl">
          {post.data.title}
        </h1>
        {post.data.tags.length > 0 && (
          <div class="mt-5 flex flex-wrap gap-x-4 gap-y-1">
            {post.data.tags.map((tag) => <TagPill tag={tag} />)}
          </div>
        )}
      </header>
      {post.data.cover && cover && (
        <img
          src={post.data.cover}
          srcset={cover.srcset}
          sizes="(max-width: 640px) 100vw, 608px"
          width={cover.width}
          height={cover.height}
          alt=""
          class="mx-auto mb-12 aspect-video w-full max-w-[38rem] rounded-sm object-cover"
        />
      )}
      <div class="prose-post">
        <Content />
      </div>
    </article>
  </div>
  <script is:inline>
    (function () {
      document.querySelectorAll('ins.adsbygoogle').forEach(() => {
        try {
          (window.adsbygoogle = window.adsbygoogle || []).push({});
        } catch (e) {
          // adsbygoogle not ready / blocked (ad blockers, offline dev, CSP) — ignore.
        }
      });
    })();
  </script>
</BaseLayout>
