---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  structuredData?: Record<string, unknown>;
}

const {
  title,
  description = 'Notes on applied AI, tooling, and consulting.',
  structuredData,
} = Astro.props;
const pageTitle = title === 'Egusto' ? title : `${title} — Egusto`;
const ogImage = new URL('/brand/banner.jpg', Astro.site).toString();
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const logoUrl = new URL('/brand/app-icon.png', Astro.site).toString();

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'egusto',
  url: Astro.site?.toString(),
  logo: logoUrl,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/brand/app-icon.png" />
    <link rel="apple-touch-icon" href="/brand/app-icon.png" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <title>{pageTitle}</title>

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} is:inline></script>
    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline></script>
    )}

    <script
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7253643000981858"
      crossorigin="anonymous"
      is:inline
    ></script>
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
